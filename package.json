{
  "name": "dsh-model-proxy",
  "version": "0.3.3",
  "description": "在 DSH 里按域名分流：命中的域名走本地 HTTP 代理或订阅代理（可托管 mihomo / sing-box 内核并自动切节点），未命中的直连；代理不通时同一次调用自动改直连。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/policy.js",
    "lib/providers.js",
    "lib/dispatcher.js",
    "lib/bridge.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "lib/subscription.js",
    "lib/core-adapter.js",
    "lib/nodes.js",
    "lib/core-manager.js",
    "lib/port-probe.js"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "proxy",
    "nekobox",
    "http-proxy",
    "mihomo",
    "sing-box",
    "subscription",
    "failover",
    "llm",
    "clash",
    "翻墙"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bansheng2000/dsh-model-proxy.git"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "undici": "^7.16.0",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.1": "compatible"
      }
    }
  }
}
